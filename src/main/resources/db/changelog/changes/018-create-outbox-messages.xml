<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="018-create-outbox-messages" author="roland">
        <createTable tableName="outbox_messages">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_type" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_payload" type="BYTEA">
                <constraints nullable="false"/>
            </column>
            <column name="company_id" type="BIGINT"/>
            <column name="document_id" type="BIGINT"/>
            <column name="lease_token" type="UUID"/>
            <column name="locked_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="next_attempt_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="publish_attempts" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_attempts" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="outbox_messages" indexName="idx_outbox_pending">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="outbox_messages" indexName="idx_outbox_lease">
            <column name="status"/>
            <column name="locked_until"/>
        </createIndex>
        <createIndex tableName="outbox_messages" indexName="idx_outbox_next_attempt">
            <column name="status"/>
            <column name="next_attempt_at"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

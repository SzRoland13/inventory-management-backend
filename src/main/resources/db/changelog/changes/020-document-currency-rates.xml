<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">
    <changeSet id="020-document-currency-rates" author="roland">
        <createTable tableName="document_exchange_rates">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="document_id" type="INTEGER"><constraints nullable="false"/></column>
            <column name="source_currency_id" type="INTEGER"><constraints nullable="false"/></column>
            <column name="rate" type="NUMERIC(24,12)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="document_exchange_rates" columnNames="document_id, source_currency_id" constraintName="uq_document_exchange_rate_source"/>
        <addForeignKeyConstraint baseTableName="document_exchange_rates" baseColumnNames="document_id" referencedTableName="documents" referencedColumnNames="id" constraintName="fk_document_exchange_rate_document" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="document_exchange_rates" baseColumnNames="source_currency_id" referencedTableName="currencies" referencedColumnNames="id" constraintName="fk_document_exchange_rate_currency" onDelete="RESTRICT"/>
        <addColumn tableName="document_lines">
            <column name="source_currency_id" type="INTEGER"/>
            <column name="exchange_rate_snapshot" type="NUMERIC(24,12)"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="document_lines" baseColumnNames="source_currency_id" referencedTableName="currencies" referencedColumnNames="id" constraintName="fk_document_line_source_currency" onDelete="RESTRICT"/>
        <sql>UPDATE document_lines dl SET source_currency_id = dl.currency_id, exchange_rate_snapshot = 1 WHERE dl.currency_id IS NOT NULL</sql>
    </changeSet>
</databaseChangeLog>

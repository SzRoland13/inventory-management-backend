<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">

        <!-- Preserve the project's established lower-snake-case package segments. -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9_]*)*$"/>
        </module>

        <!-- ========================= -->
        <!-- JAVADOC                  -->
        <!-- ========================= -->

        <!-- All non-private classes/interfaces/enums/records require Javadoc -->
        <module name="MissingJavadocType">
            <property name="scope" value="package"/>
            <property name="skipAnnotations"
                      value="Generated,SpringBootApplication,Configuration"/>
        </module>

        <!-- All non-private methods and constructors require Javadoc -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="package"/>
            <property name="allowedAnnotations" value="Override"/>
        </module>

        <!-- Validate existing method Javadocs -->
        <module name="JavadocMethod">
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
            <property name="validateThrows" value="true"/>
        </module>

        <!-- Validate class Javadocs -->
        <module name="JavadocType"/>


        <!-- ========================= -->
        <!-- FINAL                     -->
        <!-- ========================= -->

        <!-- Parameters must be final -->
        <module name="FinalParameters">
            <property name="ignorePrimitiveTypes" value="false"/>
        </module>

        <!-- Variables that are never reassigned must be final -->
        <module name="FinalLocalVariable"/>

    </module>

</module>
